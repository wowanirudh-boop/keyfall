{
  "name": "piano-practice-player",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spike:waterfall": "vite --host 127.0.0.1 --port 4190 --strictPort --open /spikes/waterfall/index.html",
    "spike:musicxml": "node spikes/musicxml/run.mjs",
    "spike:midi-clock": "vite --host 127.0.0.1 --port 4191 --strictPort --open /spikes/midi-clock/index.html",
    "lint": "eslint . --ignore-pattern dist",
    "check:types": "tsc --noEmit",
    "check:guardrails": "node scripts/check-guardrails.mjs",
    "check": "npm run check:types && npm run lint && npm run check:guardrails && npm test"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "dexie": "^4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2",
    "tone": "^15.1.22",
    "verovio": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
